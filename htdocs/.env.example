# Modelo do arquivo de configuração do site. Copie para htdocs/.env.local e preencha.
# O banco do site é o mesmo do jogo (PostgreSQL) e usa as mesmas variáveis PG* do servidor.

# endereço público do site (o site roda atrás do servidor do jogo)
NEXTAUTH_URL=http://localhost:8080
NEXT_PUBLIC_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# taxas mostradas no site
NEXT_PUBLIC_EXP_RATE=100x
NEXT_PUBLIC_DROP_RATE=100x
NEXT_PUBLIC_PENYA_RATE=100x

# cookie de sessão: COOKIE_SECURE=true (e COOKIE_DOMAIN) só quando publicar com HTTPS
COOKIE_SECURE=false
# assinatura do cookie de sessão: gere um valor aleatório longo, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
NEXTAUTH_SECRET=

# sem SMTP configurado, contas novas já nascem verificadas. REMOVA ao configurar o e-mail.
SKIP_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# loja / pagamentos (opcional)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=EUR
PAYPAL_BRAND_NAME=ReactioN MMO
